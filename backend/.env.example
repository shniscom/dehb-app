# .env.example — Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Sunucu
PORT=3000
NODE_ENV=production

# JWT — MUTLAKA değiştirin! Uzun rastgele bir string olmalı
JWT_SECRET=buraya-cok-uzun-ve-rastgele-bir-gizli-anahtar-yazin-en-az-32-karakter

# Veritabanı konumu (Docker volume için /app/data önerilir)
DB_DIR=/app/data

# CORS — frontend domaininizi yazın
ALLOWED_ORIGIN=https://gorevkahramani.com

# (İsteğe bağlı) Web Push bildirimleri için
# npx web-push generate-vapid-keys komutuyla üretin
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@gorevkahramani.com
